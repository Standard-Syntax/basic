FROM golang:1.26.0-alpine AS build
WORKDIR /src
COPY go/go.mod go/go.sum ./
RUN go mod download
COPY go/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /execution-worker ./cmd/execution-worker

FROM scratch
COPY --from=build /execution-worker /execution-worker
ENTRYPOINT ["/execution-worker"]
