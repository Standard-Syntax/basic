FROM golang:1.26.0-bookworm AS go-toolchain

FROM ghcr.io/astral-sh/uv:0.11.28 AS uv

FROM python:3.14.0-bookworm AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates make \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-toolchain /usr/local/go /usr/local/go
COPY --from=uv /uv /usr/local/bin/uv
ENV PATH="/usr/local/go/bin:/opt/bin:${PATH}" \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/opt/uv-cache
WORKDIR /src
COPY go/go.mod go/go.sum ./go/
RUN cd go && go mod download
COPY pyproject.toml uv.lock ./
COPY python/ ./python/
RUN uv sync --frozen --no-install-project \
    && uv build --wheel --out-dir /tmp/seed-wheel \
    && uv venv /tmp/seed-venv \
    && uv pip install --python /tmp/seed-venv/bin/python /tmp/seed-wheel/*.whl
COPY go/ ./go/
RUN mkdir -p /opt/bin \
    && GOBIN=/opt/bin go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.10 \
    && cd go \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
       -o /opt/bin/verification-worker ./cmd/verification-worker

FROM python:3.14.0-slim-bookworm
RUN apt-get update \
    && apt-get install -y --no-install-recommends make diffutils git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=go-toolchain /usr/local/go /usr/local/go
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=build /root/go/pkg/mod /go/pkg/mod
COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/uv-cache /opt/uv-cache
COPY --from=build /opt/bin /opt/bin
ENV PATH="/opt/bin:/opt/venv/bin:/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin" \
    GOMODCACHE=/go/pkg/mod \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/opt/uv-cache \
    UV_OFFLINE=1 \
    UV_NO_SYNC=1
USER 65532:65532
ENTRYPOINT ["/opt/bin/verification-worker"]
